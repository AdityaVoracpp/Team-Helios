# Secrets — copy to .env and fill in. Never commit .env.
# The app layer (app.py + database.py) runs fine with this file empty;
# only the RAG lane needs the key below.

# --- AI provider (canonical name: rag_service.py must read OPENAI_API_KEY) ---
OPENAI_API_KEY=
# Optional: route calls through an OpenAI-compatible gateway
OPENAI_BASE_URL=
# Model for classification + resolution synthesis
LLM_MODEL=gpt-4o-mini

# --- Database ---
# SQLite file used by database.py (default: app.db next to the app)
HELIOS_DB_PATH=app.db
