# Secrets — copy to .env and fill in. Never commit .env.
# The app layer (app.py + database.py) runs fine with this file empty;
# only the RAG lane needs the key below.

# --- AI provider (canonical name: rag_service.py must read OPENAI_API_KEY) ---
OPENAI_API_KEY=
# Optional: route calls through an OpenAI-compatible gateway. Leave it commented
# out unless you have one; an empty value is not treated as unset.
# OPENAI_BASE_URL=
# Model settings for classification, embeddings, and resolution synthesis
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Retained for other app components that use the generic model setting.
LLM_MODEL=gpt-4o-mini

# --- Database ---
# SQLite file used by database.py (default: app.db next to the app)
HELIOS_DB_PATH=app.db
# SQLite example: sqlite:///./app.db
# Postgres example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# --- App ---
APP_ENV=development
API_BASE_URL=http://localhost:8000
PORT=8000

# --- Frontend (Vite exposes only VITE_* to the browser; never put keys here) ---
VITE_API_BASE_URL=http://localhost:8000
